# OpenRouter API Configuration
OPENROUTER_API_KEY=your_api_key_here

# ──────────────────────────────────────────────────────────────────
# MODEL ROUTING (dual-model strategy)
# ──────────────────────────────────────────────────────────────────
# PRIMARY model — used for the ITEMS pass (batch codes, descriptions)
# Requires maximum character-level accuracy (W/V, M/N, J/1 errors).
MODEL_NAME=qwen/qwen3.7-plus

# FAST model — used for HEADER and TOTALS passes
# Large readable text (names, GSTINs, amounts) — no batch codes.
# 13x cheaper than Plus. Set to same as MODEL_NAME to disable routing.
FAST_MODEL_NAME=qwen/qwen3.7-flash

# Optional: separate API key for the Fast model (different OpenRouter account)
# Leave blank to use the same OPENROUTER_API_KEY for both models.
# FAST_MODEL_API_KEY=your_second_api_key_here

# Application Configuration
RENDER_DPI=150
MAX_FILE_SIZE_MB=20

# ══════════════════════════════════════════════════════════════════
# ZOOM-IN BATCH RECHECK PASS
# ══════════════════════════════════════════════════════════════════
# After the main items pass, each item row is cropped from the original
# image, upscaled, and re-read by the PRIMARY model to correct
# character-level errors in Batch / item_code / description
# (W→V, M→N, J→1, SYMBAL→SYMBOL etc.)
#
# BATCH_RECHECK_ENABLED  — set to false to skip the pass entirely
# BATCH_RECHECK_ZOOM     — upscale factor for each row crop (default 3.0)
#                          Higher = larger characters, better accuracy
#                          but also larger images sent to the API.
#                          Recommended range: 2.0 – 4.0
BATCH_RECHECK_ENABLED=true
BATCH_RECHECK_ZOOM=3.0

# ══════════════════════════════════════════════════════════════════
# PHASE 1: Caching & Two-Pass Extraction Configuration
# ══════════════════════════════════════════════════════════════════

# Result Caching
CACHE_ENABLED=true
CACHE_DIRECTORY=uploads/.cache
CACHE_MAX_AGE_HOURS=24

# Two-Pass Extraction
# (No additional config needed - controlled via UI toggle)


# ══════════════════════════════════════════════════════════════════
# PHASE 2: Multi-Page PDF Support Configuration
# ══════════════════════════════════════════════════════════════════

# Multi-page PDF processing
MAX_PDF_PAGES=20
